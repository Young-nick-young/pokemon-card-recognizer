      "header": "Normal Price (BHD)"
    },
    {
      "letter": "N",
      "key": "energyReversePriceBhd",
      "header": "Energy / Reverse Price (BHD)"
    },
    {
      "letter": "O",
      "key": "specialReversePriceBhd",
      "header": "Special Reverse Price (BHD)"
    },
    {
      "letter": "P",
      "key": "holoPriceBhd",
      "header": "Holo Price (BHD)"
    },
    {
      "letter": "Q",
      "key": "otherPriceBhd",
      "header": "Other Price (BHD)"
    },
    {
      "letter": "R",
      "key": "collectionValueBhd",
      "header": "Collection Value (BHD)"
    },
    {
      "letter": "S",
      "key": "storageLocation",
      "header": "Storage Location"
    },
    {
      "letter": "T",
      "key": "compatibilityCardId",
      "header": "Card ID"
    }
  ],
  "inventoryBuckets": [
    {
      "id": "normal",
      "quantityColumn": "G",
      "priceColumn": "M"
    },
    {
      "id": "energy/reverse-holo",
      "quantityColumn": "H",
      "priceColumn": "N"
    },
    {
      "id": "special-reverse",
      "quantityColumn": "I",
      "priceColumn": "O"
    },
    {
      "id": "holo",
      "quantityColumn": "J",
      "priceColumn": "P"
    },
    {
      "id": "other",
      "quantityColumn": "K",
      "priceColumn": "Q"
    }
  ],
  "total": {
    "column": "L",
    "operation": "sumInventoryBuckets"
  },
  "collectionValue": {
    "column": "R",
    "operation": "sumQuantityTimesPrice",
    "guardColumn": "B"
  },
  "storage": {
    "column": "S"
  },
  "identity": {
    "column": "T"
  },
  "summaries": [
    {
      "label": "Total Bulk Copies",
      "labelRange": "F1:G2",
      "valueRange": "F3:G3",
      "operation": "sumColumn",
      "column": "L"
    },
    {
      "label": "Total Bulk Value",
      "labelRange": "F6:G7",
      "valueRange": "F8:G8",
      "operation": "sumColumn",
      "column": "R",
      "numberFormat": "\"BHD \"0.000"
    },
    {
      "label": "Normal",
      "labelRange": "I1:J2",
      "valueRange": "I3:J3",
      "operation": "sumBuckets",
      "buckets": [
        "normal"
      ]
    },
    {
      "label": "Holo",
      "labelRange": "L1:M2",
      "valueRange": "L3:M3",
      "operation": "sumBuckets",
      "buckets": [
        "holo"
      ]
    },
    {
      "label": "Reverse Holo",
      "labelRange": "O1:P2",
      "valueRange": "O3:P3",
      "operation": "sumBuckets",
      "buckets": [
        "energy/reverse-holo",
        "special-reverse"
      ]
    }
  ],
  "preservationRules": {
    "standardFourVariantPathUnchanged": true,
    "dynamicVariants": true,
    "specialPatternColumn": "F",
    "unavailableQuantityCells": "blank-and-grey",
    "existingInventoryIsMigrationProtected": true
  },
  "formatting": {
    "rowHeights": {
      "headerPx": 42,
      "bodyPx": 96
    },
    "header": {
      "bold": true,
      "horizontalAlignment": "CENTER",
      "wrap": true,
      "preserveGreenWhite": true
    },
    "freezeRows": 12,
    "columnWidthsPx": {
      "A": 80,
      "B": 108,
      "C": 180,
      "D": 110,
      "E": 120,
      "F": 120,
      "G": 120,
      "H": 130,
      "I": 120,
      "J": 118,
      "K": 116,
      "L": 100,
      "M": 101,
      "N": 115,
      "O": 115,
      "P": 100,
      "Q": 100,
      "R": 110,
      "S": 100,
      "T": 96
    },
    "widthBasis": "Inventory Sheet Automation v2 semantic roles, with explicit ASC widths for Special Pattern, Energy / Reverse Holo, Special Reverse, and their price columns."
  }
}
