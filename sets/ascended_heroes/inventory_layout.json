      "key": "name",
      "header": "Card Name"
    },
    {
      "letter": "D",
      "key": "rarity",
      "header": "Rarity"
    },
    {
      "letter": "E",
      "key": "cardType",
      "header": "Card Type"
    },
    {
      "letter": "F",
      "key": "specialPattern",
      "header": "Special Pattern"
    },
    {
      "letter": "G",
      "key": "normalQty",
      "header": "Normal"
    },
    {
      "letter": "H",
      "key": "energyReverseQty",
      "header": "Energy / Reverse Holo"
    },
    {
      "letter": "I",
      "key": "specialReverseQty",
      "header": "Special Reverse"
    },
    {
      "letter": "J",
      "key": "holoQty",
      "header": "Holo"
    },
    {
      "letter": "K",
      "key": "otherQty",
      "header": "Other"
    },
    {
      "letter": "L",
