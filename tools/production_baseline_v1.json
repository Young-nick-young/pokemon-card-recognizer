  "sharedRules": {
    "canonicalId": {
      "case": "lowercase",
      "separator": "-",
      "numericWidth": 3
    },
    "legacyInventoryId": {
      "case": "uppercase-prefix",
      "separator": "-",
      "numericWidth": 3,
      "stage1Meaning": "Expected legacy IDs/configuration derived from accepted repository/schema state only.",
      "stage2Meaning": "Actual live Sheet legacy IDs must be read independently and compared against these expectations."
    },
    "collectorNumbering": {
      "sortKeySequence": "contiguous-1-through-expectedCardCount",
      "displayNumericWidth": 3
    },
    "inventoryAvailability": {
      "authoritativeRule": "inventoryVariants",
      "doNotInferFrom": "Schema cards[].variants",
